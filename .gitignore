.DS_Store
Thumbs.db

# Generated OpenFOAM time directories
# Keep biological/Case*/300 because those contain the frozen fields
cases/aeration/*/[1-9]*/
cases/aeration/*/[1-9][0-9]*/
cases/aeration/*/[1-9][0-9][0-9]*/

cases/biological/*/301/
cases/biological/*/[4-9][0-9][0-9]/
cases/biological/*/[1-9][0-9][0-9][0-9]/

# Generated mesh
# Aeration meshes can be rebuilt from blockMeshDict
cases/aeration/*/constant/polyMesh/

