FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T.air;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions          [0 0 0 1 0 0 0];

internalField   uniform 285.15;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 285.15;
    }

    outlet
    {
        type            inletOutlet;
        phi             phi.air;
        inletValue      uniform 285.15;
        value           uniform 285.15;
    }

    sideWalls
    {
        type            zeroGradient;
    }

    floor
    {
        type            zeroGradient;
    }

    atmosphere
    {
        type            inletOutlet;
        phi             phi.air;
        inletValue      uniform 285.15;
        value           uniform 285.15;
    }

    diffusers
    {
        type            fixedValue;
        value           uniform 285.15;
    }
}

