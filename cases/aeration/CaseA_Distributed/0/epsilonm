FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      epsilonm;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -3 0 0 0 0];

internalField   uniform 1e-4;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 1e-4;
    }

    outlet
    {
        type            inletOutlet;
        phi             phim;
        inletValue      uniform 1e-4;
        value           uniform 1e-4;
    }

    sideWalls
    {
        type            zeroGradient;
    }

    floor
    {
        type            zeroGradient;
    }

    atmosphere
    {
        type            inletOutlet;
        phi             phim;
        inletValue      uniform 1e-4;
        value           uniform 1e-4;
    }

    diffusers
    {
        type            zeroGradient;
    }
}

