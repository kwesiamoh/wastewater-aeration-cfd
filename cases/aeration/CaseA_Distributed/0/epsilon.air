FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      epsilon.air;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -3 0 0 0 0];

internalField   uniform 1e-4;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 1e-4;
    }

    outlet
    {
        type            inletOutlet;
        phi             phi.air;
        inletValue      uniform 1e-4;
        value           uniform 1e-4;
    }

    sideWalls
    {
        type            epsilonWallFunction;
        value           uniform 1e-4;
    }

    floor
    {
        type            epsilonWallFunction;
        value           uniform 1e-4;
    }

    atmosphere
    {
        type            inletOutlet;
        phi             phi.air;
        inletValue      uniform 1e-4;
        value           uniform 1e-4;
    }

	diffusers
	{
		type            fixedValue;
		value           uniform 1e-4;
	}
}

// ************************************************************************* //