FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nut.water;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            calculated;
        value           uniform 0;
    }

    outlet
    {
        type            calculated;
        value           uniform 0;
    }

    sideWalls
    {
        type            nutkWallFunction;
        value           uniform 0;
    }

    floor
    {
        type            nutkWallFunction;
        value           uniform 0;
    }

    atmosphere
    {
        type            calculated;
        value           uniform 0;
    }

    diffusers
    {
        type            nutkWallFunction;
        value           uniform 0;
    }
}

// ************************************************************************* //
