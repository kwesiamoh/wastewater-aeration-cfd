FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      bioTransportMeanDict;
}

functions
{
    readTransportFields
    {
        type            readFields;
        libs            (fieldFunctionObjects);

        fields
        (
            alphaUwater
            alpha.water
        );
    }

    bioTransportMean
    {
        type            fieldAverage;
        libs            (fieldFunctionObjects);

        fields
        (
            alphaUwater
            {
                mean        yes;
                prime2Mean  no;
                base        iteration;
            }

            alpha.water
            {
                mean        yes;
                prime2Mean  no;
                base        iteration;
            }
        );
    }
}

