FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k.water;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 1e-4;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 1e-4;
    }

    outlet
    {
        type            inletOutlet;
        phi             phi.water;
        inletValue      uniform 1e-4;
        value           uniform 1e-4;
    }

    sideWalls
    {
        type            kqRWallFunction;
        value           uniform 1e-4;
    }

    floor
    {
        type            kqRWallFunction;
        value           uniform 1e-4;
    }

    atmosphere
	{
		type            zeroGradient;
	}

    diffusers
    {
        type            kqRWallFunction;
        value           uniform 1e-4;
    }
}

// ************************************************************************* //
