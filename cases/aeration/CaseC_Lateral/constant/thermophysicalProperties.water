FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      thermophysicalProperties.water;
}

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       const;
    thermo          eConst;
    equationOfState rhoConst;
    specie          specie;
    energy          sensibleInternalEnergy;
}

mixture
{
    specie
    {
        molWeight   18.01528;
    }

    equationOfState
    {
        rho         1000;
    }

    thermodynamics
    {
        Cv          4190;
        Hf          0;
    }

    transport
    {
        mu          2.70e-3;
        Pr          8.9;
    }
}

