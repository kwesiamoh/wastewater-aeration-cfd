FoamFile
{
    format      ascii;
    class       dictionary;
    object      inletDiffusiveFluxDict;
}

functions
{
    gradSs
    {
        type            grad;
        libs            (fieldFunctionObjects);
        field           Ss;
        result          gradSs;
    }

    gradXs
    {
        type            grad;
        libs            (fieldFunctionObjects);
        field           Xs;
        result          gradXs;
    }

    JdiffSs
    {
        type            exprField;
        libs            (fieldFunctionObjects);

        field           JdiffSs;

        expression
            "-alpha.waterMean*(nut.waterMean/0.70)*gradSs";

        dimensions      [1 -2 -1 0 0 0 0];
    }

    JdiffXs
    {
        type            exprField;
        libs            (fieldFunctionObjects);

        field           JdiffXs;

        expression
            "-alpha.waterMean*(nut.waterMean/0.70)*gradXs";

        dimensions      [1 -2 -1 0 0 0 0];
    }

    inletDiffusiveFlux
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);

        log             true;
        writeFields     false;

        regionType      patch;
        name            inlet;

        operation       areaNormalIntegrate;

        fields
        (
            JdiffSs
            JdiffXs
        );
    }
}
