FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0";
    object      Xs;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [ 1 -3 0 0 0 0 0 ];

internalField   uniform 0.20232;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 0.20232;
    }
    outlet
    {
        type            zeroGradient;
    }
    sideWalls
    {
        type            zeroGradient;
    }
    floor
    {
        type            zeroGradient;
    }
    atmosphere
    {
        type            zeroGradient;
    }
    diffusers
    {
        type            zeroGradient;
    }
}


