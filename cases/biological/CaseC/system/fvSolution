FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}


solvers
{
    psiFlux
    {
        solver          PCG;
        preconditioner  DIC;

        tolerance       1e-12;
        relTol          0;
    }


    SS
    {
        solver          PBiCGStab;
        preconditioner  DILU;

        tolerance       1e-10;
        relTol          0;
    }


    XS
    {
        solver          PBiCGStab;
        preconditioner  DILU;

        tolerance       1e-10;
        relTol          0;
    }


    SO
    {
        solver          PBiCGStab;
        preconditioner  DILU;

        tolerance       1e-10;
        relTol          0;
    }
}


