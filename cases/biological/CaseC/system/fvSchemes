FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}


ddtSchemes
{
    default         steadyState;
}


gradSchemes
{
    default         Gauss linear;
}


divSchemes
{
    default                     none;

    div(alphaPhiBio,SS)         Gauss upwind;
    div(alphaPhiBio,XS)         Gauss upwind;
    div(alphaPhiBio,SO)         Gauss upwind;
}


laplacianSchemes
{
    default         Gauss linear uncorrected;
}


interpolationSchemes
{
    default         linear;
}


snGradSchemes
{
    default         uncorrected;
}


