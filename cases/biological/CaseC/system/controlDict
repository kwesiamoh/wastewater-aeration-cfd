FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application     aerationASM1ReducedFoam;

startFrom       startTime;
startTime       300;

stopAt          endTime;
endTime         301;

deltaT          1;

writeControl    timeStep;
writeInterval   1;

purgeWrite      0;

writeFormat     binary;
writePrecision  8;
writeCompression off;

timeFormat      general;
timePrecision   12;

runTimeModifiable true;
