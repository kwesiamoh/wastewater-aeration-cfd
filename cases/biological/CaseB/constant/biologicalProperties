FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      biologicalProperties;
}


// Molecular diffusivities [m2/s]
//
// COD molecular diffusion is neglected relative to turbulent
// dispersion in this reduced tank-scale model.

DmSs
[
    0 2 -1 0 0 0 0
]
0;

DmXs
[
    0 2 -1 0 0 0 0
]
0;


// Same DO molecular diffusivity used in aerationDOFoam

DmDO
[
    0 2 -1 0 0 0 0
]
1.6e-9;


// Turbulent Schmidt number

ScT
[
    0 0 0 0 0 0 0
]
0.70;


// -------------------------------------------------------------------------
// Reduced ASM1 / BSM1 heterotrophic parameterisation
// approximately 15 degC
// -------------------------------------------------------------------------

// Maximum heterotrophic growth rate
// 4.0 d^-1 = 4/86400 s^-1

muH
[
    0 0 -1 0 0 0 0
]
4.62962963e-5;


// Half-saturation constant for readily biodegradable COD
// 10 g/m3 = 0.010 kg/m3

Ks
[
    1 -3 0 0 0 0 0
]
0.010;


// Heterotrophic oxygen half-saturation constant
// 0.2 g/m3 = 0.0002 kg/m3

KOH
[
    1 -3 0 0 0 0 0
]
0.0002;


// Heterotrophic yield

YH
[
    0 0 0 0 0 0 0
]
0.67;


// Prescribed active heterotrophic biomass
// approximately 2550 g COD/m3 = 2.55 kg COD/m3

XBH
[
    1 -3 0 0 0 0 0
]
2.55;


// Maximum hydrolysis rate
// 3.0 d^-1 = 3/86400 s^-1

kh
[
    0 0 -1 0 0 0 0
]
3.47222222e-5;


// Hydrolysis half-saturation coefficient

KX
[
    0 0 0 0 0 0 0
]
0.10;


