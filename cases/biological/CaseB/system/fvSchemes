FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}

ddtSchemes
{
    default         steadyState;
}

gradSchemes
{
    default         Gauss linear;
}

divSchemes
{
    default         none;

	div(alphaPhi.waterMean,Xs)     Gauss upwind;
	div(alphaPhi.waterMean,Ss)     Gauss upwind;
	div(alphaPhi.waterMean,DO)     Gauss upwind;
}

laplacianSchemes
{
    default                         none;

    laplacian(alphaDeffXs,Xs)       Gauss linear corrected;
    laplacian(alphaDeffSs,Ss)       Gauss linear corrected;
    laplacian(alphaDeffDO,DO)       Gauss linear corrected;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         corrected;
}
